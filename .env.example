# Base URL API backend Laravel
# Untuk environment lokal (saat menjalankan php artisan serve), gunakan:
# VITE_API_BASE_URL=http://localhost:8000/api

# Untuk environment production, gunakan URL Railway/hosting Anda:
# VITE_API_BASE_URL=https://backendlensajentik-production.up.railway.app/api

VITE_API_BASE_URL=http://localhost:8000/api
